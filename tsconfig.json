{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true
  },
  "include": [
    "config.js",
    "config.ts",
    "bandplan-entry.ts",
    "capacitor.config.ts",
    "types/bandplan-globals.d.ts",
    "scripts/build.mjs",
    "server.js",
    "tests/types/bandplan-cloud-contract.ts",
    "core/date-utils.ts",
    "tests/types/bandplan-date-utils-contract.ts",
    "core/format-utils.ts",
    "tests/types/bandplan-format-utils-contract.ts"
  ]
}
