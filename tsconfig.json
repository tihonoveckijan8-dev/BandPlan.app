{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true
  },
  "include": [
    "config.js",
    "config.ts",
    "capacitor.config.ts",
    "types/bandplan-globals.d.ts",
    "scripts/build.mjs",
    "server.js"
  ]
}
