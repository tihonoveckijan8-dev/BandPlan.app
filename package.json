{
  "name": "bandplan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "npx --yes --package typescript@5.9.3 tsc --noEmit",
