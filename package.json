  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "0.25.9"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "express": "^5.2.1"
  }
}
